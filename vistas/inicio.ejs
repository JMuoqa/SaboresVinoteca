<link rel="stylesheet" href="/css/animacionesInicio.css">
<link rel="stylesheet" href="/css/estiloInicio.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@15.6.1/dist/nouislider.min.css">
<section class="seccion-inicio">
    <section class="seccion-categorias">
        <h2 class="subtitulos-principales subtitulos-categoorias" id="tituloCategorias">Categorias</h2>
        <section class="contenedor-de-las-categorias" id="contenedorDeLasCategorias">
            
        </section>
    </section>
    <section class="seccion-busqueda-visualizacion">
        <h2 class="subtitulos-principales">Catálogo</h2>
        <section class="contenedor-horizontal">
            <section class="seccion-filtros-busquedas">
                <form class="formulario-filtro" id="formularioFiltro">
                    <input type="hidden" id="entracaOcultaBusqueda" name="busqueda">
                    <input type="hidden" id="entradaPagina" name="pagina">
                    <fieldset class="campos">
                        <label class="etiquetas" for="entradaCategorias">Filtrar por categoria</label>
                        <select class="entradas" id="entradaCategorias" name="categoria">
                        </select>
                    </fieldset>
                    <fieldset class="campos">
                        <label class="etiquetas" for="entradaMarcas">Filtrar por Marca</label>
                        <select class="entradas" id="entradaMarcas" name="marca" >
                        </select>
                    </fieldset>
                    <fieldset class="campos">
                        <label class="etiquetas">Filtrar por Precio</label>
                        <div class="contenedor-slider">
                            <div id="slider">
                            </div>
                        </div>
                        <p>Precio: $<span id="min"></span> — $<span id="max"></span></p>
                    </fieldset>
                    <fieldset class="campos">
                        <p id="paginaLimite"></p>
                    </fieldset>
                </form>
            </section>
            <section class="seccion-productos">
                <section class="seccion-introducir-busqueda">
                    <form class="formulario-busqueda">
                        <label class="etiquetas etiqueta-de-busuqeda" for="entradaValorBusqueda">Buscar: </label>
                        <div class="diseño-entrada-busuqeda">
                            <input class="entradas entrada-busqueda" type="text" id="entradaValorBusqueda" placeholder="Vinos malbec">
                            <img class="imagen-lupa" src="/carpeta_imagenes/web/buscar.png">
                            <button class="boton boton-busqueda" type="button" id="buscarProductos">Buscar</button>
                        </div>
                    </form>
                </section>
                <section class="conteendor-productos" id="contenedorProductos">
                    
                </section>
                <section class="seccion-cambiar-pagina">
                    <img class="imagen-flecha-cambiar-pagina" id="indiceAnterior" src="/carpeta_imagenes/web/flecha-izquierda.png">
                    <p class="indice-de-pagina"><span id="numeroDePagina">1</span></p> 
                    <img class="imagen-flecha-cambiar-pagina" id="indiceSiguiente" src="/carpeta_imagenes/web/flecha-derecha.png">
                </section>
            </section>
        </section>
    </section>
    <section class="seccion-importados">
        <h2 class="subtitulos-principales" id="importados">Importados</h2>
        <section class="contenedor-de-las-importados">
            <h2 class="subtitulos-principales-sin-fondo">Catálogo | Importados</h2>
        <section class="contenedor-horizontal">
            <section class="seccion-filtros-busquedas">
                <form class="formulario-filtro" id="formularioFiltroImport">
                    <input type="hidden" id="entracaOcultaBusquedaImport" name="busqueda">
                    <input type="hidden" id="entradaPaginaImport" name="pagina">
                    <fieldset class="campos">
                        <label class="etiquetas" for="entradaCategoriasImport">Filtrar por categoria</label>
                        <select class="entradas" name="categoria" id="entradaCategoriasImport">
                        </select>
                    </fieldset>
                    <fieldset class="campos">
                        <label class="etiquetas" for="entradaMarcasImport">Filtrar por Marca</label>
                        <select class="entradas" name="marca" id="entradaMarcasImport">
                        </select>
                    </fieldset>
                    <fieldset class="campos">
                        <label class="etiquetas">Filtrar por Precio</label>
                        <div class="contenedor-slider">
                            <div id="slider-import">
                            </div>
                        </div>
                        <p>Precio: $<span id="min-import"></span> — $<span id="max-import"></span></p>
                    </fieldset>
                    <fieldset class="campos">
                        <p id="paginaLimiteImport"></p>
                    </fieldset>
                </form>
            </section>
            <section class="seccion-productos">
                <section class="seccion-introducir-busqueda">
                    <form class="formulario-busqueda">
                        <label class="etiquetas etiqueta-de-busuqeda" for="entradaValorBusqueda">Buscar: </label>
                        <div class="diseño-entrada-busuqeda">
                            <input class="entradas entrada-busqueda" type="text" id="entradaValorBusquedaImport" placeholder="Vinos malbec">
                            <img class="imagen-lupa" src="/carpeta_imagenes/web/buscar.png">
                            <button class="boton boton-busqueda" type="button" id="buscarProductosImport">Buscar</button>
                        </div>
                    </form>
                </section>
                <section class="conteendor-productos" id="conteendorProductosImportados">
                    
                </section>
                <section class="seccion-cambiar-pagina">
                    <img class="imagen-flecha-cambiar-pagina" id="indiceAnteriorImport" src="/carpeta_imagenes/web/flecha-izquierda.png">
                    <p class="indice-de-pagina"><span id="numeroDePaginaImport">1</span></p> 
                    <img class="imagen-flecha-cambiar-pagina" id="indiceSiguienteImport" src="/carpeta_imagenes/web/flecha-derecha.png">
                </section>
            </section>
        </section>
        </section>
    </section>
</section>
<script src="https://cdn.jsdelivr.net/npm/nouislider@15.6.1/dist/nouislider.min.js" defer></script>
