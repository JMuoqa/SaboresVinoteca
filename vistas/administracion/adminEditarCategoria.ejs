<link rel="stylesheet" href="/css/estiloEditarCategorias.css">
<section class="seccion-editar-productos-categorias">
    <h2 class="subtitulo-administrar">Editar categorias</h2>
    <section class="seccion-seleccionar-edicion">
        <h3>Selecciona qué deseas editar:</h3>
        <button class="boton boton-elegir" id="botonEditarMarca">Editar marcas</button>
        <button class="boton boton-elegir" id="botonEditarProductos">Editar productos</button>
    </section>
    <section class="seccion-categorias">
        <div class="contenedor-espiral contenedor-espiral-grande"  id="">
            <p ><strong>Editando datos</strong></p> <div class="animacion-espiral animacion-espiral-grande"></div>
        </div>
        <section class="contenedor-de-las-categorias" id="contenedorDeLasCategorias">
            
        </section>
    </section>
    <section class="editar-datos">
        <section class="seccion-contenedor-formulario seccion-contenedor-formulario-categorias">
        <h3 class="subtitulo-administrar">Editar categoria</h3>
        <form class="formulario formulario-carga formulario-carga-productos" id="formularioEliminarCategoria">
            <fieldset class="fieldset fieldset-completo">
                <div class="contenedor-espiral"  id="">
                    <p><strong>Cargando datos</strong></p> <div class="animacion-espiral"></div>
                </div>
                <input type="hidden" id="entradaOcultaIDEliminar" name="ID" required>
                <div class="contenedor-seguridad">
                    <label class="etiquetas" for="entradaSeguridad">Voy a eliminar</label>
                    <input class="entrada-seguridad" id="entradaSeguridad" type="checkbox">
                </div>
                <button type="submit" class="boton-elimiar" id="botonEliminar">Eliminar</button>
                <p id="textoEditarVisibilidad"></p>
            </fieldset>
        </form>
        <form class="formulario formulario-carga formulario-carga-productos" id="seccionCargaCategorias">
            <fieldset class="fieldset">
                <div class="contenedor-espiral"  id="">
                    <p ><strong>Editando datos</strong></p> <div class="animacion-espiral"></div>
                </div>
                <input type="hidden" id="entradaOcultaID" name="ID" required>
                <label class="etiquetas" for="nombreCategoria">Nombre de la categoria:</label>
                <input class="entradas" type="text" id="nombreCategoria" name="categoria" required placeholder="Vinos">
                <label class="etiquetas" for="entradaDeImagenes">Seleccionar imagen</label>
                <input class="entradas entradas-imagenes" type="file" accept="image/*" id="entradaDeImagenes" name="imagen">
                <label class="etiquetas">Imagen seleccionada: </label>
                <div class="vista-previa" id="vistaPreviaCategoria">
                    <img class="imagen-vista-previa" id="imagenVistaPrevia">
                </div>
            </fieldset>
            <fieldset class="fieldset">
                <button class="boton boton-admin-cargar boton-elegir" type="submit">Guardar categoria</button>
                <button type="button" class="boton boton-admin-cargar boton-elegir">Resetear datos</button>
                <p id="textoEdicion"></p>
            </fieldset>
        </form>
    </section>
    </section>
</section>