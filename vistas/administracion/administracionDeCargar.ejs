<link rel="stylesheet" href="/css/estiloAdminDeCargar.css">
<section class="cargar-productos-categorias">
    <h2 class="subtitulo-administrar">Cargar productos y categorias</h2>
    <section class="seccion-seleccionar-tipo-carga">
        <h3>Selecciona qué deseas cargar:</h3>
        <button class="boton boton-elegir" id="botonCargarProductos">Cargar productos</button>
        <button class="boton boton-elegir" id="botonCargarCategoria">Cargar categoria</button>
        <button class="boton boton-elegir" id="botonCargarMarca">Cargar marca</button>
    </section>
    <section class="seccion-contenedor-formulario seccion-contenedor-formulario-productos">
        <h3 class="subtitulo-administrar">Cargar producto</h3>
        <form class="formulario formulario-carga formulario-carga-productos" id="seccionCargaProductos">
            <fieldset class="fieldset">
                <label class="etiquetas" for="nombreProducto">Nombre del producto:</label>
                <input class="entradas" type="text" id="nombreProducto" name="nombreProducto" min="3" placeholder="Vino Malbec 1L" required>
                <label class="etiquetas" for="entradaDeImagenesProducto">Seleccionar imagen:</label>
                <input class="entradas" type="file" accept="image/*" id="entradaDeImagenesProducto" name="imagen" required>
                <label class="etiquetas">Imagen seleccionada: </label>
                <div class="contenedor-info-producto" id="vistaPreviaProducto">
                    <img class="imagen-del-producto" id="imagenVistaPreviaProducto" alt="Imagen del producto a subir">
                    <div class="contenedor-informacion-productos">
                        <p class="texto-info-producto nombre-del-producto"><strong id="etiquetaNombreProducto">Nombre</strong></p>
                        <div class="texto-marca-precio">
                            <p class="texto-info-producto marca-del-producto"><strong>Marca: </strong> </p>
                            <p class="texto-info-producto marca-del-producto valor-producto" id="etiquetaMarcaProducto"></p>
                        </div>
                        <div class="texto-marca-precio">
                            <p class="texto-info-producto precio-del-producto texto-marca-precio"><strong>Precio: </strong> </p>
                            <p class="texto-info-producto marca-del-producto valor-producto" id="etiquetaPrecioProducto"></p>
                        </div>
                    </div>
                </div>
                <div class="contenedor-importado">
                    <label class="etiquetas" for="entradaImportado">Importado:</label>
                    <input class="entrada entrada-importado" type="checkbox" name="importado" id="entradaImportado">
                </div>
            </fieldset>
            <fieldset class="fieldset">
                <label class="etiquetas" for="entradaCategoriaProducto">Categoria del producto:</label>
                <select class="entradas" id="entradaCategoriaProducto" name="categoria" required>
                </select>
                <label class="etiquetas" for="entradaMarca">Marca del producto:</label>
                <select class="entradas" id="entradaMarca" name="marca" required>
                </select>
                <label class="etiquetas" for="precioProducto">Precio del producto:</label>
                <input class="entradas" type="text" id="precioProducto" name="precio" placeholder="40000" required>
                <!--<label class="etiquetas" for="cantidadProducto">Cantidad</label>
                <input class="entradas" type="number" id="cantidadProducto" name="cantidad" placeholder="10" required>-->
                <button type="submit" class="boton-admin-cargar boton-elegir">Guardar producto</button>
                <button type="button" class="boton-admin-cargar boton-elegir">Resetear datos</button>
                <p id="mensajeDeAlertaProductos"></p>
            </fieldset>
        </form>
    </section>
    <section class="seccion-contenedor-formulario seccion-contenedor-formulario-categorias">
        <h3 class="subtitulo-administrar">Cargar categoria</h3>
        <form class="formulario formulario-carga formulario-carga-productos" id="seccionCargaCategorias">
            <fieldset class="fieldset">
                <label class="etiquetas" for="nombreCategoria">Nombre de la categoria:</label>
                <input class="entradas" type="text" id="nombreCategoria" name="categoria" required placeholder="Vinos">
                <label class="etiquetas" for="entradaDeImagenes">Seleccionar imagen</label>
                <input class="entradas" type="file" accept="image/*" id="entradaDeImagenes" name="imagen" required>
                <label class="etiquetas">Imagen seleccionada: </label>
                <div class="vista-previa" id="vistaPreviaCategoria">
                    <img class="imagen-vista-previa" id="imagenVistaPrevia">
                </div>
            </fieldset>
            <fieldset class="fieldset">
                <button class="boton boton-admin-cargar boton-elegir" type="submit">Guardar categoria</button>
                <button type="button" class="boton boton-admin-cargar boton-elegir">Resetear datos</button>
                <p id="mensajeDeAlertaCategoria"></p>
            </fieldset>
        </form>
    </section>
    <section class="seccion-contenedor-formulario seccion-contenedor-formulario-marcas">
        <h3 class="subtitulo-administrar">Cargar marca</h3>
        <form class="formulario formulario-carga formulario-carga-marca" id="seccionCargarMarcas">
            <fieldset class="fieldset fieldset-marca">
                <label class="etiquetas" for="">Nombre de la marca</label>
                <input class="entradas" type="text" name="marca" id="entradaCargarMarca" required placeholder="Blue label">
                <button type="submit" class="boton boton-admin-cargar boton-elegir">Guardar marca</button>
                <p id="mensajeDeAlertaMarca"></p>
            </fieldset>
        </form>
        <article class="contenedor-listado-de-marcas">
            <h4 class="subtitulo-administrar">Lista de marcas</h4>
            <ul class="listas-generales listado-marcas" id="contenedorMarcas">
            </ul>
        </article>
    </section>
</section>
