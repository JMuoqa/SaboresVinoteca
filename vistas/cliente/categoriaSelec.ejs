<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@15.6.1/dist/nouislider.min.css">
<link rel="stylesheet" href="/dist/css/estiloClienteCatSelect.bundle.css">
<section class="seccion-categoria-seleccionada">
    <h2 class="subtitulos-principales subtitulo-categoria" id="tituloCategoria"></h2>
    <section class="seccion-busqueda-visualizacion">
        <section class="contenedor-categorias-productos">
            <section>
                <h3 class="subtitulo-marcas texto-centrado margen-arriba">Marcas</h3>
                <section class="seccion-mostrar-marcas carrusel">
                    <img class="imagen-flecha-cambiar-pagina" id="indiceAnterior" src="/carpeta_imagenes/web/flecha-izquierda.png">
                    <section class="contenedor-marcas" id="contenedorSlider">

                    </section>
                    <img class="imagen-flecha-cambiar-pagina" id="indiceSiguiente" src="/carpeta_imagenes/web/flecha-derecha.png">
                </section>
            </section>
            <section class="seccion-flex">
                <section class="seccion-filtros-busquedas">
                    <form class="formulario-filtro" id="formularioFiltro">
                        <input type="hidden" id="entracaOcultaMarca" name="marca">
                        <input type="hidden" value="<%= IDCategoria %>" id="valorIDCategoria" name="categoria">
                        <input type="hidden" id="entradaPagina" name="pagina">
                        <fieldset class="campos">
                            <label class="etiquetas etiqueta-de-busuqeda" for="entradaValorBusqueda">Buscar: </label>
                            <div class="diseño-entrada-busuqeda">
                                <input class="entradas entrada-busqueda" type="text" id="entradaValorBusqueda" placeholder="Vinos malbec" name="busqueda">
                                <img class="imagen-lupa" id="imagenLupa" src="/carpeta_imagenes/web/buscar.png">
                            </div>
                            <label class="etiquetas etiqueta-filtrar">Filtrar por Precio</label>
                            <div class="contenedor-slider">
                                <div id="slider">
                                </div>
                            </div>
                            <div class="texto-flex">
                                <p>Precio: $</p><p><span id="min"></span></p><p> — $</p><p><span id="max"></span></p>
                            </div>
                        </fieldset>
                        <fieldset class="campos campo-boton">
                            <button class="boton boton-busqueda">Buscar</button>
                        </fieldset>
                        <fieldset class="campos">
                            <p id="paginaLimite"></p>
                        </fieldset>
                    </form>
                </section>
                <section class="seccion-productos">
                    <div class="contenedor-espiral"  id="animacionDeCarga">
                        <p><strong>Cargando productos</strong></p> <div class="animacion-espiral"></div>
                    </div>
                    <section class="conteendor-productos" id="contenedorProductos">
                    </section>
                    <section class="seccion-cambiar-pagina">
                        <img class="imagen-flecha-cambiar-pagina" id="indiceAnteriorPagina" src="/carpeta_imagenes/web/flecha-izquierda.png">
                        <p class="indice-de-pagina"><span id="numeroDePagina">1</span></p> 
                        <img class="imagen-flecha-cambiar-pagina" id="indiceSiguientePagina" src="/carpeta_imagenes/web/flecha-derecha.png">
                    </section>
                </section>
            </section>
            <section class="seccion-categorias">
                <h2 class="subtitulos-principales subtitulos-categoorias" id="tituloCategorias">Categorias</h2>
                <section class="contenedor-de-las-categorias" id="contenedorDeLasCategorias">

                </section>
            </section>
        </section>
    </section>
</section>
<script src="https://cdn.jsdelivr.net/npm/nouislider@15.6.1/dist/nouislider.min.js" defer></script>