<link rel="stylesheet" href="/css/estiloRegistrarse.css">
<section class="seccion-autenticacion">
    <h2 class="texto-centrado">Registrarse</h2>
    <section class="seccion-registrarse">
        <form class="formulario-autenticacion" id="formularioAut">
            <label class="etiquetas" for="entradaUsuario">Usuario</label>
            <input type="text" class="entradas" id="entradaUsuario" name="usuario" required>
            <label class="etiquetas" for="entradaEmail">Email</label>
            <input type="email" class="entradas" id="entradaEmail" name="email" required>
            <label class="etiquetas" for="entradaContrasena">Contraseña</label>
            <input type="password" class="entradas" id="entradaContrasena" name="contraseña" required>
            <label class="etiquetas" for="entradaContrasenaRepetida">Repetir contraseña</label>
            <input type="password" class="entradas" id="entradaContrasenaRepetida" name="contraseñaR" required>
            <button class="boton boton-aut boton-general" type="submit">Confirmar</button>
            <p id="mensajeAlerta"></p>
        </form>
    </section>
    <section class="seccion-mas-opciones">
            <button class="boton boton-aut boton-general" type="button" id="botonRegistrarse">Registrarse</button>
    </section>
</section>