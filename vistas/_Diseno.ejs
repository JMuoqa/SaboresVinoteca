<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/dist/css/animacionesGenerales.bundle.css">
    <link rel="stylesheet" href="/dist/css/fuentes.bundle.css">
    <link rel="stylesheet" href="/dist/css/estiloGlobal.bundle.css">
    <link rel="stylesheet" href="/dist/css/estiloPrincipal.bundle.css">
    <link rel="icon" href="/carpeta_imagenes/web/Logo128saboresvinoteca.png" type="image/png">
    <title><%= TITULO %></title>
</head>
<body>
    <dialog class="menu-desplazable menu-desplazable-productos" id="menuProductos">
        <section class="menu-hijo-desplazable" id="menuHijoProductos">
            <img class="icono-x-absolute" id="cerrarMenuProductos" src="/carpeta_imagenes/web/x-button.png">
            <h2 class="texto-blanco texto-centrado">Productos</h2>
            <ul class="listas-generales lista-secundario-categorias" id="listaSecundarioCategorias">
            </ul>
        </section>
    </dialog>
    <dialog class="menu-desplazable menu-desplazable-principal" id="menuDesPrincipal">
        <section class="menu-hijo-desplazable" id="menuHijoPrincipal">
            <img class="icono-x-absolute" id="cerrarMenuPrincipal" src="/carpeta_imagenes/web/x-button.png">
            <section class="secciones-menu-desplasable" id="contenedorMenu">
                <h2 class="texto-blanco texto-centrado texto-variable">Menu</h2>
            </section>
            <section class="secciones-menu-desplasable" id="contenedorAdmin">
            <% if(Usuario && Usuario.Jerarquia && F_AdminActivo(Usuario.Jerarquia)) { %>
                <h3 class="texto-blanco texto-centrado">Administracion</h3>
                <ul class="listas-generales lista-principal lista-principal-variable-admin" id="listaResponsivaAdmin">
                    <li class="items-generales items-principales items-principales-variables-admin items-principales-admin"><a class="links-generales links-principales-finos links-principales-variables-admin" href="/cargar-productos-categorias">Cargar productos</a></li>
                    <li class="items-generales items-principales items-principales-variables-admin items-principales-admin" ><a class="links-generales links-principales-finos links-principales-variables-admin" href="/editar-productos">Editar productos</a></li>
                </ul>
            <% }%>
            </section>
        </section>
    </dialog>
    <header class="encabezado">
        <nav class="navegador" id="navegadorPrincipal">
            <div class="filtro-negro-global"></div>
            <div class="contenedor-imagen-menu"><img class="imagen-menu" id="iconoMenuPrincipal" src="/carpeta_imagenes/web/menuSV.png"></div>
            <ul class="listas-generales lista-principal lista-principal-variable" id="listaNav">
                <li class="items-generales items-principales items-principales-variables"><a class="links-generales links-principales-finos links-principales-variables" href="/">Inicio</a></li>
                <li class="items-generales items-principales icono-separador-variable"><img class="icono-separador icono-separador-variable" src="/carpeta_imagenes/web/iconoRombo.png"></li>
                <li class="items-generales items-principales items-principales-variables"><a class="links-generales links-principales-finos links-principales-variables" id="abrirMenuProductos">Productos</a></li>
                <li class="items-generales items-principales icono-separador-variable"><img class="icono-separador icono-separador-variable" src="/carpeta_imagenes/web/iconoRombo.png"></li>
                <li class="items-generales items-principales items-principales-variables"><a class="links-generales links-principales-finos links-principales-variables" href="<%= URLMadre %>/#importados" id="linkImportados">Importados</a></li>
            </ul>
            <h1 class="titulo-marca" id="tituloMarca">SABORES VINOTECA</h1>
            <ul class="listas-generales lista-principal lista-principal-padding-invertido lista-principal-visible" id="listaAdmin">
                <% if(Usuario && Usuario.Jerarquia && F_AdminActivo(Usuario.Jerarquia)) { %>
                    <li class="items-generales items-principales " id="itemLinkAbrirMenu"><a class="links-generales links-principales-finos" id="abrirMenuCategorias">Admin</a></li>
                    <li class="items-generales items-principales icono-separador-variable" id="iconoSeparador2"><img class="icono-separador" src="/carpeta_imagenes/web/iconoRombo.png"></li>
                    <li class="items-generales items-principales"><a class="links-generales links-principales-finos" >Hola <%= Usuario.Usuario %>!</a></li>
                    <li class="items-generales items-principales"><img class="icono-separador" src="/carpeta_imagenes/web/iconoRombo.png"></li>
                    <li class="items-generales items-principales"><img class="iconos-principales idIconoSalirSession" src="/carpeta_imagenes/web/iconoPuerta.png"></li>
                <% } else if(F_UsuarioActivo(Usuario)) { %>
                    <li class="items-generales items-principales"><a class="links-generales links-principales-finos" >Hola <%= Usuario.Usuario %>!</a></li>
                    <li class="items-generales items-principales"><img class="icono-separador" src="/carpeta_imagenes/web/iconoRombo.png"></li>
                    <li class="items-generales items-principales"><img class="iconos-principales idIconoSalirSession"  src="/carpeta_imagenes/web/iconoPuerta.png"></li>
                <% } else { %>
                    <li class="items-generales items-principales"><img class="iconos-principales" src="/carpeta_imagenes/web/PersonaMuoqa.png" id="IrAut"></li>
                <% } %>
            </ul>
            <img class="imagen-logo-principal" src="/carpeta_imagenes/web/Logo540saboresvinoteca.png" id="logoPrincipal">
        </nav>
    </header>
    <main>
      <%- body %>
    </main>
    <footer class="">
        <div class="pie">
            <article class="secciones-pie seccion-horarios">
                <h2 class="subtitulos-pie">Vinoteca y Horarios</h2>
                <ul class="listas-generales lista-secundarias">
                    <li class="items-generales items-secundarios"><p class="parrafos-pie-horarios"><strong>Vinoteca:</strong></br>Barrio: Ameghino Sud.</br>Calle: Aaron Castellanos Nº2273.</br>Córdoba, Argentina 5010</p></li>
                    <li class="items-generales items-secundarios"><p class="parrafos-pie-horarios"><strong>Lunes a Sabados:</strong></br>11:00 - 23:00</p></li>
                </ul>
            </article>
            <article class="secciones-pie seccion-Redes">
                <h2 class="subtitulos-pie">Redes</h2>
                <ul class="listas-generales lista-secundarias">
                    <li class="items-generales items-secundarios"><p class="etiquetas-pie-redes"><strong>Instagram: </strong></p><img class="iconos-contacto" src="/carpeta_imagenes/web/instagram.png"><a class="links-generales links-pie-redes" rel="noopener noreferrer" href="https://www.instagram.com/vinoteca.sabores.arg/"> @vinoteca.sabores.arg</a></li>
                    <li class="items-generales items-secundarios"><p class="etiquetas-pie-redes"><strong>Whatsapp: </strong></p><img class="iconos-contacto" src="/carpeta_imagenes/web/whatsapp.png" ><a class="links-generales links-pie-redes"  rel="noopener noreferrer" target="_blank" href="https://wa.me/5493516343355"> 54 9 351-634-3355</a></li>

                </ul>
            </article>
        </div>
        <aside class="contenedor-info-muoqa">
            <a class="links-generales links-pie-redes links-muoqa texto-centrado"  rel="noopener noreferrer" target="_blank" href="https://muoqa.com">Diseñado y desarrollado por muoqa</a>
        </aside>
    </footer>
<script>
    const URLMadre = "<%= URLMadre %>";
</script>
<script src="/dist/js/principal.bundle.js" defer></script>
<% const scripts = F_DetectarJavaScript(TITULO); if(scripts.existe) { %>
    <script src="<%= scripts.js %>" defer></script>
<% } %>
</body>
</html>