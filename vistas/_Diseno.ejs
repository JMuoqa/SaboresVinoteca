<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/animacionesGenerales.css">
    <link rel="stylesheet" href="/css/fuentes.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/estiloPrincipal.css">
    <link rel="icon" href="/carpeta_imagenes/web/Logo128saboresvinoteca.png" type="image/png">
    <title><%= TITULO %></title>
</head>
<body>
    <dialog class="menu-desplazable menu-desplazable-productos" id="menuProductos">
        <section class="menu-hijo-desplazable" id="menuHijoProductos">
            <img class="icono-x-absolute" id="cerrarMenuProductos" src="/carpeta_imagenes/web/x-button.png">
            <h2 class="texto-blanco texto-centrado">Productos</h2>
            <ul class="listas-generales lista-secundario-categorias" id="listaSecundarioCategorias">
            </ul>
        </section>
    </dialog>
    <dialog class="menu-desplazable menu-desplazable-principal" id="menuDesPrincipal">
        <section class="menu-hijo-desplazable" id="menuHijoPrincipal">
            <img class="icono-x-absolute" id="cerrarMenuPrincipal" src="/carpeta_imagenes/web/x-button.png">
            <h2 class="texto-blanco texto-centrado">Menu</h2>
            <ul class="listas-generales lista-secundario-categorias" id="listaSecundarioCategorias">
            </ul>
        </section>
    </dialog>
    <header class="encabezado">
        <nav class="navegador" id="navegadorPrincipal">
            <div class="filtro-negro-global"></div>
            <div class="contenedor-imagen-menu"><img class="imagen-menu" id="iconoMenuPrincipal" src="/carpeta_imagenes/web/menuSV.png"></div>
            <ul class="listas-generales lista-principal lista-principal-variable" id="listaNav">
                <li class="items-generales items-principales"><a class="links-generales links-principales-finos" href="/">Inicio</a></li>
                <li class="items-generales items-principales"><img class="icono-separador icono-separador-variable" src="/carpeta_imagenes/web/iconoRombo.png"></li>
                <li class="items-generales items-principales"><a class="links-generales links-principales-finos" id="abrirMenuProductos">Productos</a></li>
                <li class="items-generales items-principales"><img class="icono-separador icono-separador-variable" src="/carpeta_imagenes/web/iconoRombo.png"></li>
                <li class="items-generales items-principales"><a class="links-generales links-principales-finos" href="<%= URLMadre %>/#importados">Importados</a></li>
            </ul>
            <h1 class="titulo-marca" id="tituloMarca">SABORES VINOTECA</h1>
            <ul class="listas-generales lista-principal lista-principal-padding-invertido lista-principal-visible">
                
                <% if(Usuario && Usuario.Jerarquia && F_AdminActivo(Usuario.Jerarquia)) { %>
                    <li class="items-generales items-principales"><a class="links-generales links-principales-finos" href="/cargar-productos-categorias">Cargar productos</a></li>
                <li class="items-generales items-principales"><img class="icono-separador" src="/carpeta_imagenes/web/iconoRombo.png"></li>
                    <li class="items-generales items-principales"><a class="links-generales links-principales-finos" href="/editar-productos">Editar productos</a></li>
                    <li class="items-generales items-principales"><img class="icono-separador" src="/carpeta_imagenes/web/iconoRombo.png"></li>
                <% } %>
                <% if(F_UsuarioActivo(Usuario)) { %>
                    <li class="items-generales items-principales"><img class="iconos-principales" src="/carpeta_imagenes/web/PersonaMuoqa.png"></li>
                <% } else { %>
                
                <% } %>
            </ul>
            <img class="imagen-logo-principal" src="/carpeta_imagenes/web/Logo540saboresvinoteca.png" id="logoPrincipal">
        </nav>
    </header>
    <!--<div class="imagen-presentacion-principal">
        <div class="filtro-negro-global"></div>
            <h1 class="titulo-marca">SABORES VINOTECA</h1>
    </div>-->
    <main>
      <%- body %>
    </main>
    <footer class="pie">
        <article class="secciones-pie seccion-horarios">
            <h2 class="subtitulos-pie">Vinoteca y Horarios</h2>
            <ul class="listas-generales lista-secundarias">
                <li class="items-generales items-secundarios"><p class="parrafos-pie-horarios"><strong>Vinoteca:</strong></br>Barrio: Ameghino Sud.</br>Calle: Aaron Castellanos Nº2273.</br>Córdoba, Argentina 5010</p></li>
                <li class="items-generales items-secundarios"><p class="parrafos-pie-horarios"><strong>Lunes a Sabados:</strong></br>11:00 - 23:00</p></li>
            </ul>
        </article>
        <article class="secciones-pie seccion-Redes">
            <h2 class="subtitulos-pie">Redes</h2>
            <ul class="listas-generales lista-secundarias">
                <li class="items-generales items-secundarios"><p class="etiquetas-pie-redes"><strong>Instagram:</strong></p><a class="links-generales links-pie-redes" href="https://www.instagram.com/vinoteca.sabores.arg/"> @vinoteca.sabores.arg</a></li>
                <li class="items-generales items-secundarios"><p class="etiquetas-pie-redes"><strong>Whatsapp:</strong></p><a class="links-generales links-pie-redes"> 3512223333</a></li>
                <li class="items-generales items-secundarios"><p class="etiquetas-pie-redes"><strong>Email:</strong></p><a class="links-generales links-pie-redes"> mail_ml@gmail.com</a></li>
            </ul>
        </article>
    </footer>
<script>
    const URLMadre = "<%= URLMadre %>";
</script>
<script src="/js/dist/principal.bundle.js" defer></script>
<% const scripts = F_DetectarJavaScript(TITULO); if(scripts.existe) { %>
    <script src="<%= scripts.js %>" defer></script>
<% } %>
</body>
</html>